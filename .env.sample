# Copy to .env for local runs. `azd up` writes this file for you.
# Foundry resource endpoint used for Voice Live (no trailing path)
AZURE_VOICELIVE_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/
# Foundry project endpoint (used to create the agent)
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_PROJECT_NAME=<your-project>
MODEL_DEPLOYMENT_NAME=gpt-4.1
AGENT_NAME=voice-live-agent

# Optional
# AGENT_VERSION=1                      # pin an agent version (default: latest)
# VOICELIVE_API_VERSION=2026-04-10     # Voice Live API version
# VOICELIVE_MODELS=gpt-realtime,gpt-4.1 # allow-list for "direct model" mode
# DEMO_ACCESS_CODE=change-me           # require a code before a session can start
# ENABLE_WEB_SEARCH=true               # add the web search tool when creating the agent
